# Optional — defaults to gemini-3.5-flash-lite
# GEMINI_MODEL=gemini-3.5-flash-lite

# Encrypts each user's Gemini API key in the database.
# Use a long random string. Required in production (Amplify).
# Locally it can fall back to hashing NEON_CONNECTION_STRING if unset.
SETTINGS_SECRET=replace-with-a-long-random-secret

# Neon Postgres (required)
NEON_CONNECTION_STRING=postgresql://user:password@host/neondb?sslmode=require

# --- AWS Cognito login (optional) ---
# Leave these unset to run the app without login (local development).
# When all four are set, every page and API requires a signed-in user.
# COGNITO_USER_POOL_ID=eu-north-1_XXXXXXXXX
# COGNITO_CLIENT_ID=your-app-client-id
# COGNITO_CLIENT_SECRET=your-app-client-secret
# COGNITO_DOMAIN=myapp.auth.eu-north-1.amazoncognito.com
#
# Optional — only if your app client has fewer OAuth scopes enabled.
# COGNITO_OAUTH_SCOPES=openid email profile
#
# Cognito app client checklist (AWS Console → Cognito → User pool → App integration):
# 1. Hosted UI domain created (that's COGNITO_DOMAIN above — NOT the cognito-idp issuer URL)
# 2. App client has "Authorization code grant" enabled
# 3. App client OAuth scopes include: openid, email, profile
# 4. Allowed callback URLs (exact match, include https://):
#      https://<your-amplify-url>/api/auth/callback
#      http://localhost:3000/api/auth/callback   (for local dev)
# 5. Allowed sign-out URLs:
#      https://<your-amplify-url>/login
#      http://localhost:3000/login

# Each user adds their own Gemini API key in the app under Settings
# (https://aistudio.google.com/apikey). There is no shared GEMINI_API_KEY anymore.
